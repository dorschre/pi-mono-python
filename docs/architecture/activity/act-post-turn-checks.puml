@startuml act_post_turn_checks
title Activity — _post_turn_checks: retry vs compaction (agent_session.py)

start
:agent_end received with last AssistantMessage;
if (stop_reason not in {error, aborted}?) then (yes)
  :reset overflow-recovery guard;
endif

if (retryable error? (overloaded/rate-limit/429/5xx/...)) then (yes)
  :_handle_retryable_error(msg);
  if (retried? (attempts left)) then (yes)
    :exponential backoff;
    :continue_from_context();
    :emit auto_retry_start;
    stop
  else (gave up)
    :surface error;
    stop
  endif
else (no)
  :_check_compaction(msg);
  if (usage present? (not a non-overflow error)) then (yes)
    if (is_context_overflow OR should_compact?) then (yes)
      :compact_context();
      :append compaction entry;
      :replace_messages(compacted);
    else (no)
      :no-op (within budget);
    endif
  endif
  stop
endif
@enduml
